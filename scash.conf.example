# Scash Core (scashd / scash-qt) Configuration with Active Community Nodes
chain=scash
server=1
daemon=1
txindex=1
listen=1
maxconnections=64
rpcuser=scashminer
rpcpassword=kawaiip2poolpass
rpcallowip=127.0.0.1
rpcport=8342
port=8343

[scash]
# Active Community DNS Seeds & Explorer/Pool Nodes
adddnsseed=scash.tv
adddnsseed=scash.pool-pay.com
adddnsseed=satoshicash.cedric-crispin.com
adddnsseed=seed.scash.one

# Active Community Peer Nodes (Port 8343)
addnode=scash.tv:8343
addnode=scash.pool-pay.com:8343
